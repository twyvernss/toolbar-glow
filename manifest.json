{
  "manifest_version": 3,
  "name": "Toolbar Glow",
  "version": "1.1.0",
  "description": "Matches your browser's tabs and address bar to the current site, and follows the video colours on YouTube.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toolbar Glow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
